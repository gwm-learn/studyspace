{
  "editor.renderWhitespace": "all",
  "editor.minimap.enabled": false,
  "workbench.editorAssociations": {
    "*.fit": "default"
  },
  "security.workspace.trust.untrustedFiles": "open",
  "editor.unicodeHighlight.invisibleCharacters": false,
  "hediet.vscode-drawio.resizeImages": null,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "C_Cpp.formatting": "vcFormat",
  "C_Cpp.clang_format_fallbackStyle": "GNU",
  "C_Cpp.vcFormat.newLine.closeBraceSameLine.emptyFunction": true,
  "C_Cpp.vcFormat.newLine.closeBraceSameLine.emptyType": true,
  "C_Cpp.vcFormat.space.afterCastCloseParenthesis": true,
  "C_Cpp.vcFormat.newLine.beforeOpenBrace.block": "newLine",
  "C_Cpp.vcFormat.newLine.beforeOpenBrace.function": "newLine",
  "C_Cpp.vcFormat.newLine.beforeOpenBrace.namespace": "newLine",
  "C_Cpp.vcFormat.newLine.beforeOpenBrace.type": "newLine",
  "C_Cpp.clang_format_style": "Google",
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": false,
  "json.format.enable": false,
  "launch": {
    "configurations": [],
    "compounds": []
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "asn1.keywords"
        ],
        "settings": {
          "foreground": "#C586C0"
        }
      },
      {
        "scope": [
          "asn1.moduleName"
        ],
        "settings": {
          "foreground": "#A8962A"
        }
      },
      {
        "scope": [
          "asn1.typeName"
        ],
        "settings": {
          "foreground": "#d7ba7d"
        }
      },
      {
        "scope": [
          "asn1.identifier"
        ],
        "settings": {
          "foreground": "#4CC1BB"
        }
      },
      {
        "scope": [
          "asn1.openTypeIdentifier"
        ],
        "settings": {
          "foreground": "#696969"
        }
      }
    ]
  },
  "makefile.configureOnOpen": true,
  "diffviewer.outputFormat": "line-by-line",
  "deepseek.lang": "cn",
  "roo-cline.allowedCommands": [
    "git log",
    "git diff",
    "git show"
  ],
  "roo-cline.deniedCommands": [],
  "git.openRepositoryInParentFolders": "never",
  "docker.extension.dockerEngineAvailabilityPrompt": false,
  "security.allowedUNCHosts": [
    "wsl.localhost"
  ],
  "editor.indentSize": "tabSize",
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "C_Cpp.default.compilerPath": "c:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Tools\\MSVC\\14.44.35207\\bin\\Hostx64\\x86\\cl.exe",
  "editor.gotoLocation.multipleDeclarations": "goto",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "roo-cline.debug": false,
  "workbench.colorTheme": "Default High Contrast",
  "workbench.colorCustomizations": {
    // 原有：编辑器/UI文字亮度
    "editor.foreground": "#D5D5D5",
    "sideBar.foreground": "#C5C5C5",
    "activityBar.foreground": "#C5C5C5",
    "panel.foreground": "#C5C5C5",
    "statusBar.foreground": "#C5C5C5",
    
    // 原有：终端文字配置
    "terminal.foreground": "#D5D5D5",
    "terminal.background": "#121212",
    "terminal.ansiWhite": "#D5D5D5",
    "terminal.ansiBrightWhite": "#E0E0E0",

    // 原有：选中区域背景配置
    "editor.selectionBackground": "#3A3D41",
    "editor.selectionForeground": "#E0E0E0",
    "editor.inactiveSelectionBackground": "#2D2D2D",
    "editor.wordHighlightBackground": "#404040",
    "editor.findMatchBackground": "#4A4A4A",

    // 新增：行号颜色定制（核心解决行号太亮）
    "editorLineNumber.foreground": "#888888",        // 普通行号（柔和灰，不刺眼）
    "editorLineNumber.activeForeground": "#A0A0A0",  // 当前行的行号（稍亮一点，保留辨识度）
    "editor.rangeHighlightBackground": "#282828"     // 行范围高亮背景（避免纯白）
  },
  // 终端基础配置
  "terminal.integrated.background": "#121212",
  "terminal.integrated.foreground": "#D5D5D5",
  "terminal.integrated.minimumContrastRatio": 2
}
